{
  "name": "gun-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A contract-first, durable agent harness extracted from Chat Gun runtime v4.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/kernel",
    "packages/testkit"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"packages/**/dist/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"packages/**/dist/**/*.test.js\"",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "~5.7.2"
  }
}
